NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated exact frontend origins; use one origin in production or add a known Vercel preview origin while testing.
CORS_ORIGIN=https://your-retain-frontend.example
# Production admin is provisioned from private variables at API startup; use a unique account, not the local demo.
RETAIN_ADMIN_NAME=Your Name
RETAIN_ADMIN_EMAIL=admin@example.com
RETAIN_ADMIN_PASSWORD=replace-with-a-strong-password
# Set true only when intentionally loading assessment/demo records into an empty store.
RETAIN_SEED_DEMO=false
# Only used for local development when DATABASE_URL is not set.
DATA_FILE=./data/retain.json
